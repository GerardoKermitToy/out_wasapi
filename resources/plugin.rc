#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDD_CONFIG DIALOGEX 0, 0, 490, 458
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WASAPI Output 1.2 — settings and stream information"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Playback device, buffering and access", -1, 8, 6, 474, 164
    LTEXT "Device:", -1, 16, 22, 36, 10
    COMBOBOX IDC_DEVICE, 57, 19, 352, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Refresh", IDC_REFRESH, 416, 19, 58, 15
    LTEXT "Software queue (ms):", -1, 16, 47, 94, 10
    EDITTEXT IDC_QUEUE, 112, 44, 44, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Prebuffer (ms):", -1, 168, 47, 68, 10
    EDITTEXT IDC_PREBUFFER, 238, 44, 44, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Device buffer (ms):", -1, 296, 47, 91, 10
    EDITTEXT IDC_DEVICE_BUFFER, 390, 44, 44, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Use Windows volume mixer (Winamp session)", IDC_SESSION_VOLUME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 66, 450, 12
    LTEXT "Shared mode only. Exclusive uses PCM volume; device/master volume is never changed.", -1, 16, 82, 450, 10
    CONTROL "Automatically recover after device or format changes", IDC_AUTO_RECOVER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 98, 450, 12
    CONTROL "Exclusive access to playback device", IDC_EXCLUSIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 116, 450, 12
    LTEXT "Exclusive can block other audio and requires a supported PCM format. No shared fallback.", -1, 16, 132, 450, 10
    LTEXT "Apply saves all settings for the next playback start; it does not interrupt audio.", IDC_NOTE, 16, 148, 450, 17
    GROUPBOX "Live stream information — updates every 250 ms", -1, 8, 176, 474, 247
    EDITTEXT IDC_REPORT, 16, 191, 458, 223, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Copy report", IDC_COPY, 8, 433, 77, 17
    PUSHBUTTON "Apply", IDC_APPLY, 326, 433, 73, 17
    DEFPUSHBUTTON "Close", IDOK, 407, 433, 75, 17
END

1 VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Independent WASAPI Output for Winamp\0"
            VALUE "FileVersion", "1.2.0\0"
            VALUE "InternalName", "out_wasapi\0"
            VALUE "OriginalFilename", "out_wasapi.dll\0"
            VALUE "ProductName", "WASAPI Output\0"
            VALUE "ProductVersion", "1.2.0\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 out_wasapi contributors\0"
            VALUE "Comments", "GNU GPL version 3 only (GPL-3.0-only)\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
